/tspan>\n      </text>\n\n      <!-- \"missing word\" badge — centered under the teal blank -->\n      <rect x=\"584\" y=\"232\" width=\"272\" height=\"40\" rx=\"12\" fill=\"#0093A4\"/>\n      <text x=\"720\" y=\"257\" font-family=\"Figtree, sans-serif\" font-size=\"18\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">missing word</text>\n\n      <!-- Question below card -->\n      <text x=\"720\" y=\"344\" font-family=\"Figtree, sans-serif\" font-size=\"28\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"#292F36\"></text>\n\n      <!-- ── SECTION 2: Word probability pills ── -->\n\n      <!-- High-probability pill 1 (purple, large) -->\n      <rect x=\"120\" y=\"372\" width=\"480\" height=\"130\" rx=\"65\" fill=\"#8C52BA\"/>\n      <text x=\"360\" y=\"450\" font-family=\"Figtree, sans-serif\" font-size=\"42\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">squirrel</text>\n\n      <!-- Connector -->\n      <text x=\"720\" y=\"446\" font-family=\"Figtree, sans-serif\" font-size=\"28\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"#8C52BA\">+</text>\n\n      <!-- High-probability pill 2 (purple, large) -->\n      <rect x=\"840\" y=\"372\" width=\"480\" height=\"130\" rx=\"65\" fill=\"#8C52BA\"/>\n      <text x=\"1080\" y=\"450\" font-family=\"Figtree, sans-serif\" font-size=\"42\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">mailman</text>\n\n      <!-- Low-probability pills (gray, small) -->\n      <rect x=\"160\" y=\"524\" width=\"240\" height=\"80\" rx=\"40\" fill=\"#D1D4D8\"/>\n      <text x=\"280\" y=\"572\" font-family=\"Figtree, sans-serif\" font-size=\"28\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"#4C5661\">stranger</text>\n\n      <rect x=\"440\" y=\"524\" width=\"240\" height=\"80\" rx=\"40\" fill=\"#D1D4D8\"/>\n      <text x=\"560\" y=\"572\" font-family=\"Figtree, sans-serif\" font-size=\"28\"\n            font-weight=\"600\" text