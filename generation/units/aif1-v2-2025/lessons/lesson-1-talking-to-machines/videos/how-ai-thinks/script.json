      "html": "<!-- Sequence vocabulary comment — fill in before generating connected slides:\n       Sequence: Probability Flow | Input=teal | AI Model=purple | Probability Calculation=purple | Next Word Prediction=gray | arrows=2px #292F36 -->\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Flow Diagram</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600&family=Figtree:wght@400;600&display=swap\" rel=\"stylesheet\">\n  <style>\n    /* ── Boilerplate: do not modify ── */\n    :root {\n      font-size: calc(16vh / 9); /* 1rem = 16px at design height of 900px; scales with viewport */\n      --color-teal:           #0093A4;\n      --color-purple:         #8C52BA;\n      --color-aqua:           #3CFFF7;\n      --color-error:          #E02D16;\n      --color-warning:        #F9CB28;\n      --color-success:        #3EA33E;\n      --color-info:           #1892E3;\n      --color-text-primary:   #292F36;\n      --color-text-secondary: #4C5661;\n      --color-gray-light:     #F7F8FA;\n      --color-gray-medium:    #D1D4D8;\n      --color-gray-dark:      #5F6872;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Figtree', sans-serif;\n      background: var(--color-gray-light);\n      color: var(--color-text-primary);\n    }\n    /* ── End boilerplate ── */\n\n    body {\n      display: flex;\n      flex-direction: column;\n      padding: 3rem 5rem;\n      gap: 1.5rem;\n    }\n    .slide-header { flex-shrink: 0; animation: fadeIn 0.4s ease both; }\n    .title {\n      font-family: 'Barlow Semi Condensed', sans-serif;\n      font-size: 2.5rem;\n      font-weight: 600;\n      color: var(--color-text-primary);\n      line-height: 1.1;\n      border-left: 0.5rem solid var(--color-teal);\n      padding-left: 1.25rem;\n    }\n    .svg-container {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      animation: fadeIn 0.4s ease 0.1s both;\n      min-height: 0;\n    }\n    .svg-container svg { width: 100%; height: 100%; }\n    .annotation {\n      flex-shrink: 0;\n      font-size: 1.25rem;\n      color: var(--color-text-secondary);\n      line-height: 1.5;\n      padding-left: 1.75rem;\n      border-left: 0.25rem solid var(--color-purple);\n      animation: fadeIn 0.4s ease 0.2s both;\n    }\n    body.no-title { padding-top: 2.5rem; padding-bottom: 2.5rem; }\n    body.no-title .slide-header { display: none; }\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(0.625rem); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n  </style>\n</head>\n<body>\n  <!-- Sequence vocabulary comment — fill in before generating connected slides:\n       Sequence: Probability Flow | Input=teal | AI Model=purple | Probability Calculation=purple | Next Word Prediction=gray | arrows=2px #292F36 -->\n\n  <div class=\"slide-header\">\n    <h1 class=\"title\">How AI Uses Probability</h1>\n  </div>\n\n  <div class=\"svg-container\">\n    <svg viewBox=\"0 0 1440 560\" width=\"100%\" height=\"100%\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" refX=\"9\" refY=\"3.5\" orient=\"auto\">\n          <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#292F36\"/>\n        </marker>\n      </defs>\n\n      <!-- ── Box 1 ── change fill to match visual vocabulary -->\n      <rect x=\"40\" y=\"160\" width=\"280\" height=\"220\" rx=\"20\" fill=\"#0093A4\"/>\n      <!-- Label line 1 -->\n      <text x=\"180\" y=\"234\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">Input</text>\n      <!-- Label line 2 (delete if single-line label) -->\n      \n      <!-- Subtext -->\n      \n      \n\n      <!-- ── Arrow 1→2 ── -->\n      <line x1=\"325\" y1=\"270\" x2=\"395\" y2=\"270\" stroke=\"#292F36\" stroke-width=\"2\"\n            marker-end=\"url(#arrowhead)\"/>\n\n      <!-- ── Box 2 ── -->\n      <rect x=\"405\" y=\"160\" width=\"280\" height=\"220\" rx=\"20\" fill=\"#8C52BA\"/>\n      <text x=\"545\" y=\"234\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">AI Model</text>\n      <!-- Label line 2 (delete if single-line label) -->\n      \n      <!-- Subtext -->\n      \n      \n\n      <!-- ── Arrow 2→3 ── -->\n      <line x1=\"690\" y1=\"270\" x2=\"760\" y2=\"270\" stroke=\"#292F36\" stroke-width=\"2\"\n            marker-end=\"url(#arrowhead)\"/>\n\n      <!-- ── Box 3 ── -->\n      <rect x=\"770\" y=\"160\" width=\"280\" height=\"220\" rx=\"20\" fill=\"#8C52BA\"/>\n      <text x=\"910\" y=\"234\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">Probability</text>\n      <text x=\"910\" y=\"262\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"white\">Calculation</text>\n      <!-- Subtext -->\n      \n      \n\n      <!-- ── Arrow 3→4 ── -->\n      <line x1=\"1055\" y1=\"270\" x2=\"1125\" y2=\"270\" stroke=\"#292F36\" stroke-width=\"2\"\n            marker-end=\"url(#arrowhead)\"/>\n\n      <!-- ── Box 4 — gray output box ── -->\n      <rect x=\"1135\" y=\"160\" width=\"280\" height=\"220\" rx=\"20\"\n            fill=\"#F7F8FA\" stroke=\"#D1D4D8\" stroke-width=\"3\"/>\n      <text x=\"1275\" y=\"234\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"#292F36\">Next Word</text>\n      <text x=\"1275\" y=\"262\" font-family=\"Figtree, sans-serif\" font-size=\"22\"\n            font-weight=\"600\" text-anchor=\"middle\" fill=\"#292F36\">Prediction</text>\n      <!-- Subtext -->\n      \n      \n\n      <!-- ── Bottom annotation ── delete if not needed -->\n      \n\n    </svg>\n  </div>\n\n  <!-- Delete this element if no annotation needed -->\n  \n\n</body>\n</html>\n"
    },
    {
      "comment": "Definition card for \"prompt\" with a clear explanation.",
      "speech": "A prompt is basically your instruction or question to the AI.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Header with Image</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600&family=Figtree:wght@400;600&display=swap\" rel=\"stylesheet\">\n  <style>\n    /* ── Boilerplate: do not modify ── */\n    :root {\n      font-size: calc(16vh / 9); /* 1rem = 16px at design height of 900px; scales with viewport */\n      --color-teal:           #0093A4;\n      --color-purple:         #8C52BA;\n      --color-aqua:           #3CFFF7; /* AI features only */\n      --color-error:          #E02D16;\n      --color-warning:        #F9CB28;\n      --color-success:        #3EA33E;\n      --color-info:           #1892E3;\n      --color-text-primary:   #292F36;\n      --color-text-secondary: #4C5661;\n      --color-gray-light:     #F7F8FA;\n      --color-gray-medium:    #D1D4D8;\n      --color-gray-dark:      #5F6872;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Figtree', sans-serif;\n      background: var(--color-gray-light);\n      color: var(--color-text-primary);\n    }\n    /* ── End boilerplate ── */\n\n    body {\n      display: flex;\n      flex-direction: column;\n    }\n\n    .header {\n      height: 8.75rem;\n      padding: 0 4rem;\n      display: flex;\n      align-items: center;\n      background: var(--color-gray-light);\n      flex-shrink: 0;\n      animation: fadeIn 0.4s ease both;\n    }\n\n    .heading {\n      font-family: 'Barlow Semi Condensed', sans-serif;\n      font-size: 4rem;\n      font-weight: 600;\n      color: var(--color-text-primary);\n      line-height: 1.1;\n      border-left: 0.5rem solid var(--color-teal);\n      padding-left: 1.5rem;\n    }\n\n    .image-area {\n      flex: 1;\n      overflow: hidden;\n      animation: fadeIn 0.4s ease 0.1s both;\n    }\n\n    /* Shown when no image is provided — replace with <img class=\"image\"> */\n    .image-placeholder {\n      width: 100%;\n      height: 100%;\n      background: var(--color-gray-medium);\n      border-top: 0.1875rem dashed var(--color-gray-dark);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 1.125rem;\n      font-weight: 600;\n      letter-spacing: 0.125rem;\n      color: var(--color-gray-dark);\n      text-transform: uppercase;\n    }\n\n    /* Applied to <img> after replacing the placeholder */\n    .image {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; }\n      to   { opacity: 1; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1 class=\"heading\">Not Random, But Probabilistic</h1>\n  </div>\n\n  <div class=\"image-area\">\n    <img src=\"/generation/units/aif1-v2-2025/lessons/lesson-1-talking-to-machines/videos/how-ai-thinks/images/generated_image_232a1ef5-1e8e-4b8a-a374-22f7691af016.png\" alt=\"Abstract visual contrasting a random dice roll versus a weighted dice roll to represent random vs probabilistic.\" class=\"image\">\n  </div>\n\n</body>\n</html>\n"
    },
    {
      "comment": "Thought bubble or journal entry visual, representing a student reflecting on how prompts change AI output.",
      "speech": "Reflecting on your activities, you observed directly how updating your prompts and adding different types of input like images changed the AI's output. This is a key insight into working effectively with AI.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Big Quote / Key Stat</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600&family=Figtree:wght@400;600&display=swap\" rel=\"stylesheet\">\n  <style>\n    /* ── Boilerplate: do not modify ── */\n    :root {\n      font-size: calc(16vh / 9); /* 1rem = 16px at design height of 900px; scales with viewport */\n      --color-teal:           #0093A4;\n      --color-purple:         #8C52BA;\n      --color-aqua:           #3CFFF7; /* AI features only */\n      --color-error:          #E02D16;\n      --color-warning:        #F9CB28;\n      --color-success:        #3EA33E;\n      --color-info:           #1892E3;\n      --color-text-primary:   #292F36;\n      --color-text-secondary: #4C5661;\n      --color-gray-light:     #F7F8FA;\n      --color-gray-medium:    #D1D4D8;\n      --color-gray-dark:      #5F6872;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Figtree', sans-serif;\n      color: var(--color-text-primary);\n    }\n    /* ── End boilerplate ── */\n\n    body {\n      background: linear-gradient(150deg, var(--color-purple) 0%, #5a2d8a 100%);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .card {\n      background: #ffffff;\n      border-radius: 1.5rem;\n      box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.3);\n      padding: 3.5rem 5rem;\n      max-width: 90rem;\n      width: 100%;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 1.25rem;\n      animation: fadeIn 0.4s ease both;\n    }\n\n    .quote-mark {\n      font-family: 'Barlow Semi Condensed', sans-serif;\n      font-size: 6.25rem;\n      font-weight: 600;\n      color: var(--color-purple);\n      line-height: 0.7;\n      opacity: 0.25;\n      user-select: none;\n    }\n\n    .big-text {\n      font-family: 'Barlow Semi Condensed', sans-serif;\n      font-size: 7rem;\n      font-weight: 600;\n      color: var(--color-text-primary);\n      line-height: 1.1;\n    }\n\n    .secondary {\n      font-size: 2rem;\n      font-weight: 400;\n      color: var(--color-text-secondary);\n      line-height: 1.5;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; transform: scale(0.96); }\n      to   { opacity: 1; transform: scale(1); }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"quote-mark\">\"</div>\n    <blockquote class=\"big-text\">Prompt</blockquote>\n    <p class=\"secondary\">your instruction or question to the AI</p>\n  </div>\n\n</body>\n</html>\n"
